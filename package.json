{
  "name": "oakbkapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "security:scan:tracked": "powershell -ExecutionPolicy Bypass -File scripts/security/scan-tracked-secrets.ps1",
    "security:scan:history": "powershell -ExecutionPolicy Bypass -File scripts/security/scan-history-secrets.ps1",
    "security:scan": "npm run security:scan:tracked && npm run security:scan:history"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "^2.95.3",
    "next": "15.5.10",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.10",
    "typescript": "^5",
    "vitest": "1.6.1"
  },
  "overrides": {
    "esbuild": "^0.25.11"
  }
}
